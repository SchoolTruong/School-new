# Bắt buộc: bộ não Claude
ANTHROPIC_API_KEY=

# Bắt buộc khi nói bằng giọng (nhận dạng tiếng Việt qua Whisper)
OPENAI_API_KEY=

# Tuỳ chọn: gọi điện thoại qua Twilio (xem README)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Tuỳ chọn
# JARVIS_MODEL=claude-sonnet-5-5
# JARVIS_VOICE=Linh          # giọng macOS (chạy `say -v '?'` để xem danh sách)
# JARVIS_RATE=190            # tốc độ đọc
# JARVIS_SILENCE=500         # ngưỡng im lặng, tăng nếu phòng ồn
# JARVIS_AUTO_APPROVE=0      # 1 = không hỏi xác nhận (không khuyến nghị)
